# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repositorio.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Clave del servidor para el modo gratuito (https://console.groq.com/keys).
# Si se deja vacía, solo funciona el modo BYOK (clave del usuario).
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Orígenes del frontend permitidos por CORS (separados por comas).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcional, para las previews de Vercel:
# ALLOWED_ORIGIN_REGEX=https://cv-optimizer-.*\.vercel\.app

# Opcional: clave de Jina Reader para leer ofertas por URL (sin ella hay límite por IP).
# JINA_API_KEY=

MAX_UPLOAD_MB=5
MAX_PDF_PAGES=5
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30
