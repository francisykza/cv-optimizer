# Copia este archivo a .env (python -m hunter init ya crea uno con el token local).
# Nunca subas .env al repositorio.

HUNTER_TOKEN=lo-genera-hunter-init

# --- Juez IA (Fase 2) ---
# Clave personal de Groq: https://console.groq.com/keys . Sin ella, el pipeline llega hasta la guillotina.
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# Tope propio de tokens al día (ajústalo a la cuota de tu plan en console.groq.com).
HUNTER_DAILY_TOKEN_BUDGET=150000
# Punto de partida del limitador; se ajusta solo con las cabeceras de Groq.
HUNTER_TOKENS_PER_MINUTE=6000
HUNTER_JUDGE_MAX_INPUT_CHARS=6000
HUNTER_JUDGE_MAX_OUTPUT_TOKENS=2048

# --- Opcional ---
# LOG_LEVEL=INFO
# HUNTER_SOURCE_TIMEOUT_S=90
# HUNTER_RETENTION_DAYS=90
# JINA_API_KEY=
